# Database settings used by PostgreSQL, the API, and the worker.
POSTGRES_DB=os_insight
POSTGRES_USER=os_insight
# Local development default only; set a private password for real deployments.
POSTGRES_PASSWORD=change-me
# Host ports for the API and dashboard; container ports stay unchanged.
API_HOST_PORT=8001
WEB_HOST_PORT=3000
# Internal URL used by the web server to proxy requests to the API service.
API_BASE_URL=http://api:8000